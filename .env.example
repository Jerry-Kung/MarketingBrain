# ==========================================================
# Marketing Brain V0.2 环境配置示例
# 复制为 .env 并填写实际值。实际 .env 不进入版本库。
# 切勿在示例文件中填写真实凭据（数据库密码/API Key）。
# ==========================================================

# ---------- 应用运行 ----------
APP_ENV=development
APP_PORT=19783
APP_LOG_LEVEL=info

# ---------- 应用状态存储（SQLite 持久化目录） ----------
# 本地 / Docker 均可使用相对路径，Docker 中挂载到持久化卷
APP_STATE_DIR=.data/state

# ---------- 测试环境 MySQL（只读账号，仅 SELECT） ----------
# 使用只读账号，仅授 SELECT 权限。密码特殊字符需 URL-encode（见 docs/评论数据获取说明.md）。
DB_HOST=你的_MYSQL_HOST
DB_PORT=3306
DB_USER=你的_MYSQL_只读账号
DB_PASSWORD=你的_MYSQL_密码
DB_NAME=drive_intent_backend
DB_CHARSET=utf8mb4

# ---------- LLM（V0.2 已启用） ----------
# 用于舆情策略包报告生成（OpenAI-compatible 接口）。
# LLM_API_BASE=
# LLM_API_KEY=
# LLM_MODEL=
# LLM 请求超时（毫秒）；普通请求默认 120s。注意：报告生成请求会覆盖为 ≥300s
#（推理模型输出预算大、耗时较长）。
LLM_TIMEOUT_MS=120000

# ---------- 运行参数 ----------
# 前端轮询间隔（毫秒）
UI_POLL_INTERVAL_MS=2500

# 单次工具最大返回记录数（防止超大数据）
TOOL_MAX_RECORDS=500

# ---------- V0.3 Skill 与工作流配置 ----------
SKILLS_DIR=skills
DEFAULT_SKILL=opinion-pulse
WORKFLOW_STAGE_TIMEOUT_MS=300000
ENABLE_WORKFLOW_ENGINE=true

# ---------- V0.4 Agent 配置 ----------
# 主开关：true 走 V0.4 受控 Agent（主 Agent + 子 Agent Loop + 评审）
ENABLE_AGENT_ENGINE=true
AGENT_MAX_SUBTASKS=6
AGENT_MAX_LOOPS=3
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_SUPPLEMENTS=1
AGENT_LLM_TIMEOUT_MS=300000
